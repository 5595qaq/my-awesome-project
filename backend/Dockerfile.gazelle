FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG GAZELLE_REF=main
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip git ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements.gazelle.txt ./
RUN pip3 install --no-cache-dir torch==2.3.1 torchvision==0.18.1 \
      --index-url https://download.pytorch.org/whl/cu121 \
    && pip3 install --no-cache-dir -r requirements.gazelle.txt \
    && pip3 install --no-cache-dir "git+https://github.com/fkryan/gazelle.git@${GAZELLE_REF}"
COPY . .
CMD ["pgq", "run", "app.gazelle_worker:main"]
